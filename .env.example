# Copy to .env and fill in. NEVER commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite in dev. For PostgreSQL:
# DATABASE_URL=postgres://expense:expense@localhost:5432/expense_tracker

# Email (Gmail SMTP). Leave blank in dev: emails are printed to the console instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Expense Tracker <noreply@example.com>
