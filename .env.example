# Copy to .env and fill in. NEVER commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite in dev. For PostgreSQL:
# DATABASE_URL=postgres://expense:expense@localhost:5432/expense_tracker

# --- Docker / production only --------------------------------------------------------
# docker compose reads these. Use a real random value for DJANGO_SECRET_KEY outside local testing.
POSTGRES_PASSWORD=expense
# Origins allowed to call the API from a browser (the React dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to false ONLY when running over plain http locally (docker compose); keep true when deployed.
USE_HTTPS=true
# Host ports used by docker compose (change if 8000 / 5432 are already in use).
# WEB_PORT=8000
# DB_PORT=5432

# Email (Gmail SMTP). Leave blank in dev: emails are printed to the console instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Expense Tracker <noreply@example.com>
